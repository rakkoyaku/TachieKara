<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      デザイントークン。画面側では必ずこの名前（DynamicResource）で色を参照する。
      Surface0 = ウィンドウ地 / Surface1 = パネル / Surface2 = 入力欄・カード / Surface3 = ホバー
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#6B4FD8</Color>
            <SolidColorBrush x:Key="Surface0" Color="#F3F3F6" />
            <SolidColorBrush x:Key="Surface1" Color="#FBFBFC" />
            <SolidColorBrush x:Key="Surface2" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Surface3" Color="#ECECF1" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#E8E8EE" />
            <SolidColorBrush x:Key="CanvasBackdrop" Color="#E2E2E8" />
            <SolidColorBrush x:Key="Stroke" Color="#E2E2E8" />
            <SolidColorBrush x:Key="StrokeStrong" Color="#CFCFD8" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1A1A21" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5F5F6B" />
            <SolidColorBrush x:Key="TextTertiary" Color="#8E8E99" />
            <SolidColorBrush x:Key="Accent" Color="#6B4FD8" />
            <SolidColorBrush x:Key="AccentHover" Color="#5C40C9" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1A6B4FD8" />
            <SolidColorBrush x:Key="AccentText" Color="#5536C2" />
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Warning" Color="#B86E00" />
            <SolidColorBrush x:Key="WarningSoft" Color="#1FE89A0C" />
            <SolidColorBrush x:Key="Danger" Color="#D92D3A" />
            <SolidColorBrush x:Key="DangerSoft" Color="#1AD92D3A" />
            <SolidColorBrush x:Key="Success" Color="#1A8754" />
            <SolidColorBrush x:Key="Shadow" Color="#22000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentColor">#8E78F0</Color>
            <SolidColorBrush x:Key="Surface0" Color="#141418" />
            <SolidColorBrush x:Key="Surface1" Color="#1B1B20" />
            <SolidColorBrush x:Key="Surface2" Color="#232329" />
            <SolidColorBrush x:Key="Surface3" Color="#2C2C33" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#111114" />
            <SolidColorBrush x:Key="CanvasBackdrop" Color="#0E0E11" />
            <SolidColorBrush x:Key="Stroke" Color="#2A2A31" />
            <SolidColorBrush x:Key="StrokeStrong" Color="#3A3A43" />
            <SolidColorBrush x:Key="TextPrimary" Color="#ECECF1" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A3A3AE" />
            <SolidColorBrush x:Key="TextTertiary" Color="#6E6E79" />
            <SolidColorBrush x:Key="Accent" Color="#8E78F0" />
            <SolidColorBrush x:Key="AccentHover" Color="#9D8AF3" />
            <SolidColorBrush x:Key="AccentSoft" Color="#268E78F0" />
            <SolidColorBrush x:Key="AccentText" Color="#B4A6F7" />
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Warning" Color="#F2B544" />
            <SolidColorBrush x:Key="WarningSoft" Color="#24F2B544" />
            <SolidColorBrush x:Key="Danger" Color="#F2666E" />
            <SolidColorBrush x:Key="DangerSoft" Color="#24F2666E" />
            <SolidColorBrush x:Key="Success" Color="#4CC38A" />
            <SolidColorBrush x:Key="Shadow" Color="#66000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 角丸・余白（4px グリッド） -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">6</CornerRadius>
    <CornerRadius x:Key="RadiusL">10</CornerRadius>
    <CornerRadius x:Key="RadiusXL">14</CornerRadius>
</ResourceDictionary>
